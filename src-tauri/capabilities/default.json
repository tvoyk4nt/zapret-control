{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "C:/zapret-discord-youtube-1.10.3"
        },
        {
          "path": "C:/zapret-discord-youtube-1.10.3/**"
        },
        {
          "path": "$APPDATA/Backups"
        },
        {
          "path": "$APPDATA/Backups/**"
        }
      ]
    }
  ]
}